generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MEMBER
  VIEWER
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  password        String
  avatar          String?
  slackToken      String?
  slackTeamId     String?
  slackTeamName   String?
  createdAt       DateTime       @default(now())
  boards          Board[]
  boardMembers    BoardMember[]
  activities      Activity[]
  notifications   Notification[]
  comments        Comment[]
  assignedCards   CardAssignee[]
  resetTokens     PasswordResetToken[]
  websites        Website[]
  chatMessages    ChatMessage[]
  assignedConversations Conversation[]
  websiteMemberships WebsiteMember[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Board {
  id              String        @id @default(cuid())
  title           String
  background      String        @default("#0079bf")
  slackToken      String?
  slackChannelId  String?
  slackChannelName String?
  slackTeamName   String?
  userId          String
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members         BoardMember[]
  lists           List[]
  labels          Label[]
  notifications   Notification[]
}

model BoardMember {
  id        String    @id @default(cuid())
  boardId   String
  userId    String
  role      Role      @default(MEMBER)
  position  Int       @default(0)
  deletedAt DateTime?
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model List {
  id        String    @id @default(cuid())
  title     String
  position  Int
  boardId   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
}

model Card {
  id          String       @id @default(cuid())
  title       String
  description String?
  position    Int
  listId      String
  dueDate     DateTime?
  coverColor  String?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  labels      CardLabel[]
  checklists  Checklist[]
  attachments Attachment[]
  activities  Activity[]
  comments    Comment[]
  assignees   CardAssignee[]
}

model CardAssignee {
  cardId    String
  userId    String
  deletedAt DateTime?
  card      Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
}

model Label {
  id      String      @id @default(cuid())
  name    String
  color   String
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   CardLabel[]
}

model CardLabel {
  cardId    String
  labelId   String
  deletedAt DateTime?
  card      Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label     Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
}

model Checklist {
  id        String          @id @default(cuid())
  title     String
  cardId    String
  deletedAt DateTime?
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  content     String
  isCompleted Boolean   @default(false)
  checklistId String
  deletedAt   DateTime?
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String    @id @default(cuid())
  filename  String
  url       String
  cardId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    String
  boardId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  cardId    String
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  cardId    String?
  userId    String
  createdAt DateTime @default(now())
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Live chat (Crisp klonu) ──────────────────────────────────────────

/// Bir web sitesi = bir chat kutusu. publicKey embed script'te kullanılır.
model Website {
  id              String         @id @default(cuid())
  name            String
  domain          String?
  publicKey       String         @unique @default(cuid())
  // Widget görünüm ayarları
  color           String         @default("#1e88e5")
  welcomeMessage  String         @default("Merhaba! Size nasıl yardımcı olabiliriz?")
  operatorName    String         @default("Destek")
  position        String         @default("right") // right | left
  active          Boolean        @default(true)
  userId          String
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitors        Visitor[]
  conversations   Conversation[]
  members         WebsiteMember[]

  @@index([userId])
}

/// Bir siteye atanmış operatör (sahip dışındaki kullanıcılar). Kaldırma = soft-delete.
model WebsiteMember {
  id        String    @id @default(cuid())
  websiteId String
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([websiteId, userId])
  @@index([userId])
}

/// Widget'ı açan bir ziyaretçi. token kalıcı çerezle eşlenir.
model Visitor {
  id            String         @id @default(cuid())
  token         String         @unique @default(cuid())
  websiteId     String
  name          String?
  email         String?
  ip            String?
  userAgent     String?
  country       String?
  city          String?
  timezone      String?  // IANA tz, ör. "Europe/Istanbul" (tarayıcıdan)
  language      String?  // navigator.language, ör. "tr-TR"
  currentUrl    String?
  referrer      String?
  online        Boolean        @default(false)
  lastSeenAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([websiteId])
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

model Conversation {
  id             String             @id @default(cuid())
  websiteId      String
  visitorId      String
  status         ConversationStatus @default(OPEN)
  assignedUserId String?
  lastMessageAt  DateTime           @default(now())
  visitorUnread  Int                @default(0) // ziyaretçinin okumadığı (operatör mesajı) sayısı
  operatorUnread Int                @default(0) // operatörün okumadığı (ziyaretçi mesajı) sayısı
  createdAt      DateTime           @default(now())
  website        Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor        Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  assignedUser   User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]

  @@index([websiteId])
  @@index([visitorId])
}

enum ChatSender {
  VISITOR
  OPERATOR
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  sender         ChatSender
  userId         String?      // operatör mesajıysa gönderen kullanıcı
  body           String
  readAt         DateTime?    // karşı tarafça okunma zamanı
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId])
}
